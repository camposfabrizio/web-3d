# Credenciais do app Strava (crie em https://www.strava.com/settings/api).
# Copie para .env.local (NÃO commite valores reais) ou configure no painel da Vercel.
#
# STRAVA_CLIENT_ID     — "Client ID" do seu app Strava (público)
# STRAVA_CLIENT_SECRET — "Client Secret" do seu app Strava (mantenha em segredo)

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
